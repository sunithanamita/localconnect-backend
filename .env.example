PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/localconnect
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Payments: leave keys empty to use MOCK mode (no real gateway needed while developing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Seed script (set SEED_LAT / SEED_LNG to your own city's coordinates)
ADMIN_EMAIL=admin@localconnect.dev
ADMIN_PASSWORD=Admin@12345
SEED_LAT=28.6139
SEED_LNG=77.2090
